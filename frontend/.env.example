# Copy to .env.local for local development (git-ignored).
# Points at api-gateway, which routes to every backend service.
#
# Local development only. vite inlines this at build time, and the containerised
# storefront overrides it at runtime from /config.js (root .env -> API_BASE_URL),
# so setting it here does not affect a deployed frontend. See src/lib/runtime-config.ts.
VITE_API_BASE_URL=http://localhost:8080/api/v1
