{
  "uid": "kafka-consumer-lag",
  "title": "Kafka — Consumer Lag & Partitions",
  "description": "Answers one question: is consumption keeping up, and if not, is the partition count the thing holding it back? Fed by kafka-exporter, which reads offsets from the broker rather than from the services, so lag stays visible while a consumer is down. Internal topics (_consumer_offsets, the Connect config/offset/status topics) are filtered out of every panel.",
  "tags": ["kafka", "messaging"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Brokers up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [{ "refId": "A", "expr": "kafka_brokers", "instant": true }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Topics",
      "description": "Business topics only — internal Kafka and Kafka Connect topics are excluded.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "count(kafka_topic_partitions{topic!~\"_.*\"})", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total partitions",
      "description": "Summed across all business topics. With one partition per topic this equals the topic count — the two tiles diverging is the visible sign that a partition increase has landed.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(kafka_topic_partitions{topic!~\"_.*\"})", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst consumer lag",
      "description": "Highest lag across every group and partition right now. A number that keeps climbing is the signal to add partitions; one that spikes and drains is a burst being absorbed normally.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [{ "refId": "A", "expr": "max(kafka_consumergroup_lag)", "instant": false }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer lag by group",
      "description": "The panel that decides whether to act. Flat at zero, or spiking and returning to zero, means consumption is keeping up. A line that trends upward and never comes back down means the group is permanently behind — check whether the listener itself is slow before adding partitions, since more partitions only multiply pressure on a slow downstream call.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisLabel": "messages behind"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lag by topic",
      "description": "Same data split by topic instead of by group, to show which topic is actually behind. Only that topic needs more partitions — raising the count on quiet topics costs broker resources for nothing.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisLabel": "messages behind"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_consumergroup_lag{topic!~\"_.*\"})",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Messages produced by topic (msg/s)",
      "description": "Arrival rate per topic. Read together with lag: high rate and flat lag means the consumers are comfortably ahead, so the partition count is fine no matter how busy the topic looks.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisLabel": "msg/s"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic!~\"_.*\"}[5m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Partitions per topic",
      "description": "The ceiling on parallelism for each topic: a topic with N partitions can never have more than N consumers working on it within one group, however many instances are running.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Topic", "desc": false }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_topic_partitions{topic!~\"_.*\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true
            },
            "renameByName": { "topic": "Topic", "Value": "Partitions" },
            "indexByName": {}
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Consumers vs lag by group",
      "description": "Read this against the partitions table to the left. Members above the partition count means consumers are sitting idle and partitions are the binding constraint — raising them is what unblocks throughput. Members at or below the partition count with lag still growing means the consumers themselves are the constraint, and more instances (or faster listener code) is the fix instead.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Lag" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 100 },
                    { "color": "red", "value": 1000 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Lag", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_members",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true
            },
            "renameByName": {
              "consumergroup": "Consumer group",
              "Value #A": "Members",
              "Value #B": "Lag"
            },
            "indexByName": {}
          }
        }
      ]
    }
  ]
}
