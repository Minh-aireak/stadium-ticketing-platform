<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aireak</groupId>
        <artifactId>stadium-ticketing-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>api-gateway</artifactId>
    <name>API Gateway</name>
    <description>API Gateway — routing, auth filter, rate limiting. No DDD — purely technical concern.</description>

    <dependencies>
        <!-- Spring Cloud Gateway (WebFlux-based reactive routing) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- The gateway starter pulls in the raw spring-boot-webflux module transitively, but
             NOT the Boot 4.1 webflux-autoconfigure module that registers ServerProperties /
             the reactive embedded-server beans Spring Cloud Gateway's own NettyConfiguration
             requires — without this, the app fails to start at all
             (UnsatisfiedDependencyException on ServerProperties). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redisson — distributed RedisRateLimiter backing store (reactive), same client
             every other service in this project uses. Pulls in spring-boot-starter-data-redis
             + spring-data-redis transitively, which is what Spring Cloud Gateway's
             GatewayRedisAutoConfiguration needs (ReactiveRedisTemplate bean) to expose the
             RedisRateLimiter/redisRequestRateLimiterScript beans. -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- Nimbus JOSE+JWT (via spring-security-oauth2-jose) — replaces jjwt for local JWT
             validation. jjwt 0.12.x depends on com.fasterxml.jackson (Jackson 2) which conflicts
             with Spring Boot 4.1's Jackson 3 autoconfiguration. Nimbus is already the JWT library
             used by Spring Security internally and has no Jackson dependency. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Real Redis for rate-limiter tests — same "test against real infra" pattern the
             other services already use (Testcontainers Postgres). Version from the root
             testcontainers-bom import. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
