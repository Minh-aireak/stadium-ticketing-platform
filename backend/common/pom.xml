<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aireak</groupId>
        <artifactId>stadium-ticketing-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common</artifactId>
    <name>Common Module</name>
    <description>Cross-cutting technical concerns: EventEnvelope, ProblemDetail handler, CorrelationId filter, BaseAuditEntity, KafkaTopics, DomainException. NO domain models from any bounded context.</description>

    <dependencies>
        <!-- Lombok (annotation processor, optional — consumer decides) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>


        <!-- Jackson 3.x is provided transitively by spring-boot-starter-web (via spring-boot-jackson
             autoconfiguration module). JavaTimeModule is built-in to Jackson 3 — no separate
             registration needed. Explicit com.fasterxml.jackson deps removed: Spring Boot 4.1
             manages tools.jackson.* through its BOM. -->

        <!-- Web concern: CorrelationIdFilter, GlobalExceptionHandler (optional — only web services pull this) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JPA concern: BaseAuditEntity (optional — only JPA services pull this) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Bean Validation API: GlobalExceptionHandler maps ConstraintViolationException
             (optional — only services with a validation starter on the classpath throw it) -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Kafka constants only (no kafka runtime here — services pull spring-kafka themselves) -->
        <!-- KafkaTopics.java is just a class with String constants, no runtime dep needed -->

        <!-- Nimbus JOSE+JWT — replaces jjwt for JWT generation and validation.
             jjwt 0.12.x uses com.fasterxml.jackson (Jackson 2) and has no Jackson 3 support.
             Nimbus is already the JWT library used by Spring Security internally
             (spring-security-oauth2-jose depends on it); no extra version to manage. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
